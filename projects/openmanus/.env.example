# Ejemplo de archivo .env para OpenManus

# Clave de API para el modelo de lenguaje (ej. OpenAI, Gemini)
# OPENAI_API_KEY="tu_clave_api_openai"
# GEMINI_API_KEY="tu_clave_api_gemini"

# URL base para la API del LLM (si es diferente del predeterminado)
# LLM_BASE_URL="https://api.openai.com/v1"

# Configuración para herramientas de búsqueda (ej. Serper API)
# SERPER_API_KEY="tu_clave_api_serper"
